# SAPOK TECH website — environment settings
# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Database (required on Vercel) -----------------------------------------
# MongoDB Atlas connection string. Without it, local dev stores data in ./.data instead.
MONGODB_URI=
MONGODB_DB=sapok_website

# --- Admin sessions (required in production) --------------------------------
# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- First-run admin account (optional) -------------------------------------
# The owner account is seeded into the database on first sign-in.
# Defaults: sapoktech.c@gmail.com / Passw0rd — change the password in Admin → Settings afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email notifications for new enquiries ----------------------------------
# Gmail: SMTP_USER is the Gmail address, SMTP_PASS is a 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=sapoktech.c@gmail.com
SMTP_PASS=
# Where enquiry emails go (defaults to SMTP_USER)
NOTIFY_EMAIL=sapoktech.c@gmail.com
# Only for non-Gmail providers:
# SMTP_HOST=
# SMTP_PORT=465

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
